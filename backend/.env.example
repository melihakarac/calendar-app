# Default: docker compose `db` service (calendar / calendar / calendar).
# For `docker run` with user/password/challenge_db, replace DATABASE_URL accordingly.
DATABASE_URL="postgresql://calendar:calendar@localhost:5432/calendar?schema=public"
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Same IANA zone as the browser (Intl.DateTimeFormat().resolvedOptions().timeZone) so seeded "today" matches the UI.
# SEED_TIMEZONE=Europe/Warsaw
